CONFIG_PATH = Path("/etc/applock/apps.json")
ADMIN_TOOL = "/usr/local/bin/applock-admin"
POLL_SECONDS = 30


class AppLockAdmin(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.thomas.AppLockConfig")
        self.window = None
        self.interface_settings = Gio.Settings.new("org.gnome.desktop.interface")
        self.interface_settings.connect(
            "changed::color-scheme",
            self.on_color_scheme_changed,
        )

    def apply_color_scheme(self):
        display = Gdk.Display.get_default()
        if display is None:
            return
        gtk_settings = Gtk.Settings.get_for_display(display)
        scheme = self.interface_settings.get_string("color-scheme")
        prefer_dark = scheme in ("prefer-dark", "dark")
        gtk_settings.set_property(
            "gtk-application-prefer-dark-theme",
            prefer_dark,
        )

    def on_color_scheme_changed(self, _settings, _key):
        self.apply_color_scheme()

    def do_activate(self):
        if self.window is None:
            self.window = AppLockWindow(application=self)
        self.window.present()
        self.apply_color_scheme()


class TimePicker(Gtk.Box):
    __gsignals__ = {
        "changed": (GObject.SignalFlags.RUN_FIRST, None, ()),
    }

    def __init__(self, **kwargs):
        super().__init__(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=4,
            halign=Gtk.Align.START,
            valign=Gtk.Align.CENTER,
            **kwargs,
        )

        self._updating = False
        self.hour_spin = Gtk.SpinButton.new_with_range(0, 23, 1)
        self.minute_spin = Gtk.SpinButton.new_with_range(0, 59, 1)

        for button in (self.hour_spin, self.minute_spin):
            button.set_numeric(True)
            button.set_wrap(True)
            button.set_snap_to_ticks(True)
            button.set_width_chars(2)
            button.set_max_width_chars(2)
            button.set_hexpand(False)
            button.set_valign(Gtk.Align.CENTER)
            button.connect("value-changed", self._on_value_changed)

        separator = Gtk.Label(label=":")
        separator.set_valign(Gtk.Align.CENTER)

        self.append(self.hour_spin)
        self.append(separator)
        self.append(self.minute_spin)

        self.hour_spin.set_increments(1, 6)
        self.minute_spin.set_increments(1, 10)

    def _on_value_changed(self, _button):
        if self._updating:
            return
        self.emit("changed")

    def get_text(self):
        return f"{int(self.hour_spin.get_value()):02d}:{int(self.minute_spin.get_value()):02d}"

    def set_text(self, text):
        value = common.parse_time(text)
        hour, minute = divmod(value, 60) if value is not None else (0, 0)

        self._updating = True
        try:
            self.hour_spin.set_value(hour)
            self.minute_spin.set_value(minute)
        finally:
            self._updating = False


