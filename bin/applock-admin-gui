    def set_status(self, message, error=False):
        self.status_label.set_text(message)
        if error:
            self.status_label.remove_css_class("dim-label")
            self.status_label.add_css_class("error")
        else:
            self.status_label.remove_css_class("error")
            self.status_label.add_css_class("dim-label")

    def load_config(self):
        try:
            config = common.load_config(CONFIG_PATH)
            self.apps = config.get("apps", {})
            self.websites = config.get("websites", {})
        except Exception as exc:
            self.apps = {}
            self.websites = {}
            self.set_status(f"Unable to load configuration: {exc}", error=True)
            self.refresh_combo()
            self.refresh_website_combo()
            return

        self.set_status("Configuration loaded")
        self.refresh_combo()
        self.refresh_website_combo()

    def refresh_combo(self):
        selected = self.selected_name
        self.app_list.splice(0, self.app_list.get_n_items(), [])
        for name in sorted(self.apps):
            self.app_list.append(name)

        if selected in self.apps:
            self.select_app(selected)
        elif self.apps:
            self.select_app(sorted(self.apps)[0])
        else:
            self.selected_name = None
            self.app_combo.set_selected(Gtk.INVALID_LIST_POSITION)
            self.populate_details()

    def select_app(self, name):
        self.selected_name = name
        index = Gtk.INVALID_LIST_POSITION if name is None else sorted(self.apps).index(name)
        self.app_combo.set_selected(index)
        self.populate_details()

    def refresh_website_combo(self):
        selected = self.selected_website
        self.website_list.splice(
            0, self.website_list.get_n_items(), []
        )
        for name in sorted(self.websites):
            self.website_list.append(name)

        if selected in self.websites:
            self.select_website(selected)
        elif self.websites:
            self.select_website(sorted(self.websites)[0])
        else:
            self.selected_website = None
            self.website_combo.set_selected(Gtk.INVALID_LIST_POSITION)
            self.populate_website_details()

    def select_website(self, name):
        self.selected_website = name
        index = (
            Gtk.INVALID_LIST_POSITION
            if name is None
            else sorted(self.websites).index(name)
        )
        self.website_combo.set_selected(index)
        self.populate_website_details()

    def on_website_changed(self, combo, _param):
        selected = combo.get_selected()
        if selected == Gtk.INVALID_LIST_POSITION:
            name = None
        else:
            name = self.website_list.get_string(selected)
        self.selected_website = name
        self.populate_website_details()

    def populate_website_details(self):
        website = self.websites.get(self.selected_website)
        enabled = website is not None

        for widget in (
            self.website_name_value,
            self.website_hosts_value,
            self.website_always_switch,
            self.website_start_entry,
            self.website_end_entry,
            self.website_status_value,
        ):
            widget.set_sensitive(enabled)

        if website is None:
            self.website_name_value.set_text("No blocked websites")
            self.website_hosts_value.set_text("")
            self.website_always_switch.set_active(True)
            self.website_start_entry.set_text("")
            self.website_end_entry.set_text("")
            self.website_status_value.set_text("")
            return

        schedule = website.get("schedule", {"always": True})
        always = bool(schedule.get("always", True))
        self.website_name_value.set_text(self.selected_website)
        self.website_hosts_value.set_text(
            ", ".join(website.get("domains", [self.selected_website]))
        )
        self.website_always_switch.set_active(always)
        self.website_start_entry.set_text(schedule.get("start", ""))
        self.website_end_entry.set_text(schedule.get("end", ""))
        self.update_website_status()

    def update_website_status(self):
        website = self.websites.get(self.selected_website)
        if website is None:
            return
        blocked = common.schedule_is_locked(website.get("schedule"))
        self.website_status_value.set_text(
            "Blocked now" if blocked else "Allowed now"
        )
        if blocked:
            self.website_status_value.add_css_class("error")
        else:
            self.website_status_value.remove_css_class("error")

    def on_website_always_changed(self, switch, _param):
        always = switch.get_active()
        self.website_start_entry.set_sensitive(not always)
        self.website_end_entry.set_sensitive(not always)
        website = self.websites.get(self.selected_website)
        if website is not None:
            schedule = website.setdefault("schedule", {})
            schedule["always"] = always
        self.update_website_status()

    def on_website_schedule_changed(self, _entry):
        website = self.websites.get(self.selected_website)
        if website is None:
            return
        schedule = website.setdefault("schedule", {"always": False})
        schedule["always"] = False
        schedule["start"] = self.website_start_entry.get_text().strip()
        schedule["end"] = self.website_end_entry.get_text().strip()
        self.update_website_status()

    def on_add_website_clicked(self, _button):
        value = self.website_add_entry.get_text().strip()
        if not value:
            self.set_status("Enter a website domain or URL", error=True)
            return

        try:
            name, domains = common.parse_website(value)
        except ValueError as exc:
            self.set_status(str(exc), error=True)
            return

        if name in self.websites:
            self.set_status(f"{name} is already configured", error=True)
            return

        self.websites[name] = {
            "domain": name,
            "domains": domains,
            "schedule": {"always": True},
        }
        self.website_add_entry.set_text("")
        self.refresh_website_combo()
        self.select_website(name)
        self.set_status(f"Added {name}. Choose a schedule, then apply.")

    def on_remove_website_clicked(self, _button):
        if self.selected_website is None:
            return

        name = self.selected_website
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text=f"Stop blocking {name}?",
        )
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("_Remove", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.connect("response", self.on_remove_website_response, name)
        dialog.present()

    def on_remove_website_response(self, dialog, response, name):
        dialog.destroy()
        if response != Gtk.ResponseType.OK or name not in self.websites:
            return
        del self.websites[name]
        self.refresh_website_combo()
        self.set_status(f"Removed {name}. Apply to save the change.")

    def on_app_changed(self, combo, _param):
        selected = combo.get_selected()
        if selected == Gtk.INVALID_LIST_POSITION:
            name = None
        else:
            name = self.app_list.get_string(selected)
        self.selected_name = name
        self.populate_details()

    def populate_details(self):
        app = self.apps.get(self.selected_name)
        enabled = app is not None

        for widget in (
            self.name_value,
            self.path_value,
            self.always_switch,
            self.start_entry,
            self.end_entry,
            self.status_value,
        ):
            widget.set_sensitive(enabled)

        self.flatpak_id_label.set_visible(False)
        self.flatpak_id_value.set_visible(False)
        self.flatpak_id_value.set_text("")
        if app is None:
            self.name_value.set_text("No locked apps")
            self.path_value.set_text("")
            self.always_switch.set_active(True)
            self.start_entry.set_text("")
            self.end_entry.set_text("")
            self.status_value.set_text("")
            return

        is_flatpak = app.get("type") == "flatpak"
        self.flatpak_id_label.set_visible(is_flatpak)
        self.flatpak_id_value.set_visible(is_flatpak)
        schedule = app.get("schedule", {"always": True})
        always = bool(schedule.get("always", True))
        self.name_value.set_text(self.selected_name)
        self.path_value.set_text(app.get("path", ""))
        if is_flatpak:
            self.flatpak_id_value.set_text(app.get("flatpak_id", ""))
        self.always_switch.set_active(always)
        self.start_entry.set_text(schedule.get("start", ""))
        self.end_entry.set_text(schedule.get("end", ""))
        self.update_current_status()

    def on_status_tick(self):
        self.update_current_status()
        self.update_website_status()
        return GLib.SOURCE_CONTINUE

    def update_current_status(self):
        app = self.apps.get(self.selected_name)
        if app is None:
            return
        locked = common.schedule_is_locked(app.get("schedule"))
        self.status_value.set_text("Locked now" if locked else "Unlocked now")
        if locked:
            self.status_value.add_css_class("error")
        else:
            self.status_value.remove_css_class("error")

    def on_always_changed(self, switch, _param):
        always = switch.get_active()
        self.start_entry.set_sensitive(not always)
        self.end_entry.set_sensitive(not always)
        app = self.apps.get(self.selected_name)
        if app is not None:
            app.setdefault("schedule", {})
            app["schedule"]["always"] = always
        self.update_current_status()

    def on_schedule_changed(self, _entry):
        app = self.apps.get(self.selected_name)
        if app is None:
            return
        schedule = app.setdefault("schedule", {"always": False})
        schedule["always"] = False
        schedule["start"] = self.start_entry.get_text().strip()
        schedule["end"] = self.end_entry.get_text().strip()
        self.update_current_status()

    def on_add_clicked(self, _button):
        chooser = Gtk.FileChooserNative.new(
            "Choose an application",
            self,
            Gtk.FileChooserAction.OPEN,
            "_Add",
            "_Cancel",
        )
        chooser.set_modal(True)

        executable_filter = Gtk.FileFilter()
        executable_filter.set_name("Executable files")
        executable_filter.add_mime_type("application/x-executable")
        executable_filter.add_mime_type("application/x-sharedlib")
        executable_filter.add_pattern("*.sh")
        chooser.add_filter(executable_filter)

        all_filter = Gtk.FileFilter()
        all_filter.set_name("All files")
        all_filter.add_pattern("*")
        chooser.add_filter(all_filter)

        chooser.connect("response", self.on_add_response)
        chooser.show()

    def on_add_response(self, chooser, response):
        if response != Gtk.ResponseType.ACCEPT:
            chooser.destroy()
            return

        file = chooser.get_file()
        chooser.destroy()
        if file is None:
            return

        path = file.get_path()
        if not path or not os.path.isfile(path) or not os.access(path, os.X_OK):
            self.set_status("Choose an executable application file", error=True)
            return

        name = Path(path).stem
        if name in self.apps:
            self.set_status(f"An app named {name} is already configured", error=True)
            return

        self.apps[name] = {
            "path": path,
            "argv": [path],
            "schedule": {"always": True},
        }
        self.refresh_combo()
        self.select_app(name)
        self.set_status(f"Added {name}. Choose a schedule, then apply.")

    def get_desktop_apps(self):
        apps_by_id = {}

        for info in Gio.DesktopAppInfo.get_all():
            if not info.should_show():
                continue

            if info.get_executable() == "/usr/local/bin/applock-launch" or (
                info.get_commandline() or "").startswith("/usr/local/bin/applock-launch"):
                info = self.load_original_desktop_info(info)
                if info is None:
                    continue

            app_id = info.get_id()
            if not app_id:
                continue
            apps_by_id[app_id] = info

        return sorted(apps_by_id.values(), key=lambda info: (info.get_name() or "").casefold())

    def load_original_desktop_info(self, override_info):
        app_id = override_info.get_id()
        search_paths = [
            Path("/usr/share/applications"),
            Path.home() / ".local/share/applications",
            Path("/var/lib/flatpak/exports/share/applications"),
            Path.home() / ".local/share/flatpak/exports/share/applications",
            Path("/usr/local/share/applications"),
        ]

        for directory in search_paths:
            path = directory / app_id
            if not path.is_file():
                continue

            try:
                info = Gio.DesktopAppInfo.new_from_filename(str(path))
            except Exception:
                continue

            if info and info.get_executable() != "/usr/local/bin/applock-launch":
                return info

        return None

    def on_browse_apps_clicked(self, _button):
        dialog = Gtk.Dialog(transient_for=self, modal=True)
        self.browse_dialog = dialog
        dialog.set_title("Choose application")
        dialog.set_default_size(560, 420)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.set_margin_top(18)
        content.set_margin_bottom(18)
        content.set_margin_start(18)
        content.set_margin_end(18)
        dialog.get_content_area().append(content)

        search_entry = Gtk.SearchEntry()
        search_entry.set_placeholder_text("Search installed applications…")
        search_entry.set_hexpand(True)
        content.append(search_entry)

        scrolled_window = Gtk.ScrolledWindow()
        scrolled_window.set_hexpand(True)
        scrolled_window.set_vexpand(True)
        scrolled_window.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        content.append(scrolled_window)

        self.browse_list = Gtk.ListBox()
        self.browse_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.browse_list.set_activate_on_single_click(False)
        self.browse_list.connect("row-activated", self.on_browse_row_activated)
        scrolled_window.set_child(self.browse_list)

        for info in self.get_desktop_apps():
            row = Gtk.ListBoxRow()
            row.desktop_info = info

            row_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            row_box.set_margin_top(10)
            row_box.set_margin_bottom(10)
            row_box.set_margin_start(12)
            row_box.set_margin_end(12)

            name_label = Gtk.Label(label=info.get_name(), halign=Gtk.Align.START)
            name_label.set_single_line_mode(True)
            name_label.set_ellipsize(Pango.EllipsizeMode.END)
            row_box.append(name_label)

            executable = info.get_executable() or info.get_commandline() or ""
            subtitle = f"{info.get_id()}  •  {executable}"
            subtitle_label = Gtk.Label(label=subtitle, halign=Gtk.Align.START)
            subtitle_label.add_css_class("dim-label")
            subtitle_label.set_single_line_mode(True)
            subtitle_label.set_ellipsize(Pango.EllipsizeMode.END)
            row_box.append(subtitle_label)

            row.set_child(row_box)
            self.browse_list.append(row)

        self.browse_query = ""
        search_entry.connect("search-changed", self.on_browse_search_changed)
        self.browse_list.set_filter_func(self.filter_browse_row)

        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        select_button = dialog.add_button("_Select", Gtk.ResponseType.OK)
        select_button.add_css_class("suggested-action")
        dialog.set_default_widget(select_button)
        dialog.connect("response", self.on_browse_dialog_response)
        dialog.present()

    def on_browse_search_changed(self, entry):
        self.browse_query = entry.get_text().strip().casefold()
        self.browse_list.invalidate_filter()

    def filter_browse_row(self, row):
        if not self.browse_query:
            return True

        info = row.desktop_info
        haystack = "\n".join((
            info.get_name() or "",
            info.get_id() or "",
            info.get_executable() or "",
            info.get_commandline() or "",
        )).casefold()

        return self.browse_query in haystack

    def on_browse_dialog_response(self, dialog, response):
        if response != Gtk.ResponseType.OK:
            dialog.destroy()
            return

        row = self.browse_list.get_selected_row()
        dialog.destroy()

        if row is None:
            self.set_status("Select an application first", error=True)
            return

        self.add_desktop_app(row.desktop_info)

    def on_browse_row_activated(self, _list_box, row):
        self.add_desktop_app(row.desktop_info)
        self.browse_dialog.destroy()

    def get_flatpak_apps(self):
        """Return installed, user-visible Flatpak launchers by application ID."""
        apps_by_id = {}
        for info in self.get_desktop_apps():
            flatpak_id = info.get_string("X-Flatpak")
            if flatpak_id:
                apps_by_id[flatpak_id.strip()] = info
        return sorted(apps_by_id.items(), key=lambda item: item[0].casefold())

    def on_add_flatpak_clicked(self, _button):
        dialog = Gtk.Dialog(transient_for=self, modal=True)
        dialog.set_title("Add Flatpak")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(18)
        box.set_margin_bottom(18)
        box.set_margin_start(18)
        box.set_margin_end(18)
        dialog.get_content_area().append(box)

        self.flatpak_choices = self.get_flatpak_apps()
        self.flatpak_list = Gtk.StringList()
        for app_id, info in self.flatpak_choices:
            label = f"{info.get_name()} — {app_id}" if info.get_name() else app_id
            self.flatpak_list.append(label)

        installed_label = Gtk.Label(label="Installed Flatpak apps", halign=Gtk.Align.START)
        installed_label.add_css_class("heading")
        box.append(installed_label)

        self.flatpak_choice_dropdown = Gtk.DropDown.new(self.flatpak_list)
        self.flatpak_choice_dropdown.set_hexpand(True)
        box.append(self.flatpak_choice_dropdown)

        grid = Gtk.Grid()
        grid.set_row_spacing(10)
        grid.set_column_spacing(10)
        box.append(grid)

        name_label = Gtk.Label(label="Application name", halign=Gtk.Align.START)
        self.flatpak_name_entry = Gtk.Entry()
        self.flatpak_name_entry.set_placeholder_text("GIMP")
        grid.attach(name_label, 0, 0, 1, 1)
        grid.attach(self.flatpak_name_entry, 1, 0, 1, 1)

        id_label = Gtk.Label(label="Application ID", halign=Gtk.Align.START)
        self.flatpak_id_entry = Gtk.Entry()
        self.flatpak_id_entry.set_placeholder_text("org.gimp.GIMP")
        self.flatpak_id_entry.set_width_chars(28)
        grid.attach(id_label, 0, 1, 1, 1)
        grid.attach(self.flatpak_id_entry, 1, 1, 1, 1)

        self.flatpak_choice_dropdown.connect(
            "notify::selected",
            self.on_flatpak_choice_changed,
        )
        if self.flatpak_choices:
            self.flatpak_choice_dropdown.set_selected(0)
            self.on_flatpak_choice_changed(self.flatpak_choice_dropdown, None)

        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        add_button = dialog.add_button("_Add", Gtk.ResponseType.OK)
        add_button.add_css_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.connect("response", self.on_add_flatpak_response)
        dialog.present()

    def on_flatpak_choice_changed(self, dropdown, _param):
        selected = dropdown.get_selected()
        if selected == Gtk.INVALID_LIST_POSITION or selected >= len(self.flatpak_choices):
            return

        flatpak_id, _info = self.flatpak_choices[selected]
        self.flatpak_id_entry.set_text(flatpak_id)
        self.flatpak_name_entry.set_text(Path(flatpak_id).stem)

    def on_add_flatpak_response(self, dialog, response):
        if response == Gtk.ResponseType.OK:
            flatpak_id = self.flatpak_id_entry.get_text().strip()
            display_name = self.flatpak_name_entry.get_text().strip()
            dialog.destroy()
            if not flatpak_id:
                self.set_status("Enter a Flatpak application ID", error=True)
                return
            if not display_name:
                display_name = Path(flatpak_id).stem
            self.add_flatpak_app(flatpak_id, display_name)
        else:
            dialog.destroy()

    def add_flatpak_app(self, flatpak_id, display_name):
        flatpak_id = flatpak_id.strip()
        display_name = display_name.strip()
        if not flatpak_id:
            self.set_status("Flatpak application ID is required", error=True)
            return
        if not display_name:
            display_name = Path(flatpak_id).stem
        if display_name in self.apps:
            self.set_status(f"An app named {display_name} is already configured", error=True)
            return
        for configured_name, info in self.apps.items():
            if info.get("type") == "flatpak" and info.get("flatpak_id") == flatpak_id:
                self.set_status(f"{configured_name} is already configured", error=True)
                return

        self.apps[display_name] = {
            "path": "/usr/bin/flatpak",
            "argv": ["/usr/bin/flatpak", "run", flatpak_id],
            "schedule": {"always": True},
            "type": "flatpak",
            "flatpak_id": flatpak_id,
        }
        self.refresh_combo()
        self.select_app(display_name)
        self.set_status(f"Added Flatpak {display_name}. Choose a schedule, then apply.")

    def add_desktop_app(self, info):
        if info is None:
            return

        app_name = Path(info.get_id()).stem
        if not app_name:
            self.set_status("Desktop entry has no usable application ID", error=True)
            return

        if app_name in self.apps:
            self.set_status(f"An app named {app_name} is already configured", error=True)
            return

        executable = info.get_executable()
        commandline = info.get_commandline() or ""
        if not executable:
            executable = commandline.split()[0] if commandline else ""

        if not executable:
            self.set_status("Desktop entry has no executable command", error=True)
            return

        executable_path = Path(executable)
        if not executable_path.is_absolute():
            executable = shutil.which(executable) or ""

        if not executable:
            self.set_status("Could not resolve the application executable", error=True)
            return

        if Path(executable).name == "flatpak":
            flatpak_id = info.get_string("X-Flatpak") or app_name

            self.apps[app_name] = {
                "path": executable,
                "argv": [executable, "run", flatpak_id],
                "schedule": {"always": True},
                "type": "flatpak",
                "flatpak_id": flatpak_id,
                "desktop_id": info.get_id(),
            }
        else:
            resolved_path = Path(executable).resolve(strict=True)
            if not resolved_path.is_file() or not os.access(resolved_path, os.X_OK):
                self.set_status(f"Could not resolve executable: {resolved_path}", error=True)
                return

            self.apps[app_name] = {
                "path": str(resolved_path),
                "argv": [str(resolved_path)],
                "schedule": {"always": True},
            }

        self.refresh_combo()
        self.select_app(app_name)
        self.set_status(f"Added {app_name} from the app menu. Choose a schedule, then apply.")

    def on_remove_clicked(self, _button):
        if self.selected_name is None:
            return
        name = self.selected_name
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text=f"Stop locking {name}?",
        )
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("_Remove", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.connect("response", self.on_remove_response, name)
        dialog.present()

    def on_remove_response(self, dialog, response, name):
        dialog.destroy()
        if response != Gtk.ResponseType.OK or name not in self.apps:
            return
        del self.apps[name]
        self.refresh_combo()
        self.set_status(f"Removed {name}. Apply to save the change.")

    def on_set_code_clicked(self, _button):
        dialog = Gtk.Dialog(transient_for=self, modal=True)
        dialog.set_title("Set unlock code")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(18)
        box.set_margin_bottom(18)
        box.set_margin_start(18)
        box.set_margin_end(18)

        code_entry = Gtk.Entry()
        code_entry.set_visibility(False)
        code_entry.set_placeholder_text("New code")
        confirm_entry = Gtk.Entry()
        confirm_entry.set_visibility(False)
        confirm_entry.set_placeholder_text("Confirm code")
        box.append(code_entry)
        box.append(confirm_entry)
        dialog.get_content_area().append(box)

        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("_Set code", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.connect(
            "response",
            self.on_set_code_response,
            (code_entry, confirm_entry),
        )
        dialog.present()

    def on_set_code_response(self, dialog, response, state):
        code_entry, confirm_entry = state
        if response != Gtk.ResponseType.OK:
            dialog.destroy()
            return

        code = code_entry.get_text()
        confirm = confirm_entry.get_text()
        dialog.destroy()
        if not code or code != confirm:
            self.set_status("Codes do not match", error=True)
            return

        self.run_admin_async(
            ["pkexec", ADMIN_TOOL, "set-code-stdin"],
            "Unlock code updated",
            "Unable to set unlock code",
            stdin_data=code + "\n",
        )

    def on_sync_clicked(self, _button):
        self.run_admin_async(
            ["pkexec", ADMIN_TOOL, "sync"],
            "App Lock rules and website blocks synchronized",
            "Unable to synchronize App Lock rules and website blocks",
        )

    def on_apply_clicked(self, _button):
        if self.applying:
            return
        if not self.validate_config():
            return

        fd, temp_path = tempfile.mkstemp(prefix="applock-gui-", suffix=".json")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump(
                    {"apps": self.apps, "websites": self.websites},
                    handle,
                    indent=2,
                )
        except Exception as exc:
            self.set_status(f"Unable to write configuration: {exc}", error=True)
            return

        self.run_admin_async(
            ["pkexec", ADMIN_TOOL, "apply-config", temp_path],
            "Configuration applied",
            "Unable to apply configuration",
            cleanup=temp_path,
        )

    def validate_config(self):
        if not self.apps and not self.websites:
            self.set_status("Add at least one application or website", error=True)
            return False

        for name, app in self.apps.items():
            path = app.get("path")
            if not path or not os.path.isfile(path) or not os.access(path, os.X_OK):
                self.set_status(f"{name}: executable path is invalid", error=True)
                return False

            schedule = app.get("schedule", {"always": True})
            if schedule.get("always", True):
                continue

            start = common.parse_time(schedule.get("start"))
            end = common.parse_time(schedule.get("end"))
            if start is None or end is None:
                self.set_status(f"{name}: use HH:MM lock times", error=True)
                return False

            schedule["start"] = f"{start // 60:02d}:{start % 60:02d}"
            schedule["end"] = f"{end // 60:02d}:{end % 60:02d}"

        for name, website in self.websites.items():
            if not isinstance(website, dict):
                self.set_status(f"{name}: invalid website entry", error=True)
                return False

            try:
                common.parse_website(name)
                domains = website.get("domains", [name])
                if not isinstance(domains, list):
                    raise ValueError(f"{name}: blocked hosts must be a list")
                for domain in domains:
                    common.normalize_domain(domain)
            except ValueError as exc:
                self.set_status(str(exc), error=True)
                return False

            schedule = website.get("schedule", {"always": True})
            if schedule.get("always", True):
                continue

            start = common.parse_time(schedule.get("start"))
            end = common.parse_time(schedule.get("end"))
            if start is None or end is None:
                self.set_status(f"{name}: use HH:MM blocking times", error=True)
                return False

            schedule["start"] = f"{start // 60:02d}:{start % 60:02d}"
            schedule["end"] = f"{end // 60:02d}:{end % 60:02d}"

        return True

    def run_admin_async(self, command, success_message, error_message, cleanup=None, stdin_data=None):
        if self.applying:
            return
        self.applying = True
        self.apply_button.set_sensitive(False)
        self.sync_button.set_sensitive(False)
        self.set_status("Waiting for administrator authorization…")
        thread = threading.Thread(
            target=self.run_admin_thread,
            args=(command, success_message, error_message, cleanup, stdin_data),
            daemon=True,
        )
        thread.start()

    def run_admin_thread(self, command, success_message, error_message, cleanup=None, stdin_data=None):
        try:
            result = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                input=stdin_data,
                text=True,
                check=False,
            )
            output = result.stdout.strip()
            error = result.stderr.strip()
            success = result.returncode == 0
        except Exception as exc:
            success = False
            output = ""
            error = str(exc)
        finally:
            if cleanup:
                try:
                    os.unlink(cleanup)
                except Exception:
                    pass

        GLib.idle_add(self.finish_admin_command, success, output, error, success_message, error_message)

    def finish_admin_command(self, success, output, error, success_message, error_message):
        self.applying = False
        self.apply_button.set_sensitive(True)
        self.sync_button.set_sensitive(True)

        if success:
            self.set_status(output or success_message)
            self.load_config()
        else:
            self.set_status(error or output or error_message, error=True)
        return False


if __name__ == "__main__":
    app = AppLockAdmin()
    exit_status = app.run(sys.argv)
    sys.exit(exit_status)
