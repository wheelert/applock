#!/usr/bin/python3
import hmac
import hashlib
import json
import os
import pwd
import subprocess
import socket
import struct
import threading
import time
import grp
import signal
import sys
from pathlib import Path

sys.path.insert(0, os.environ.get("APPLOCK_LIB", "/usr/local/lib/applock"))
import applock_common as common

SOCKET_PATH = os.environ.get("APPLOCK_SOCKET", "/run/applock/applock.sock")
CONFIG_PATH = Path(os.environ.get("APPLOCK_APPS", "/etc/applock/apps.json"))
CODE_PATH = Path(os.environ.get("APPLOCK_CODE", "/etc/applock/code"))
MAX_REQUEST_SIZE = 64 * 1024
FAILURE_WINDOW = 60
FAILURE_LIMIT = 5

failures = {}
failures_lock = threading.Lock()
server_socket = None

def read_code():
    salt = None
    expected = None
    with CODE_PATH.open("r", encoding="utf-8") as handle:
        for line in handle:
            if line.startswith("salt="):
                salt = line[5:].strip()
            elif line.startswith("hash="):
                expected = line[5:].strip().lower()
    if not salt or not expected:
        raise RuntimeError("invalid code file")
    return salt, expected

def load_config():
    config = common.load_config(CONFIG_PATH)
    if not isinstance(config.get("apps"), dict):
        raise RuntimeError("invalid app registry")
    if not isinstance(config.get("websites"), dict):
        raise RuntimeError("invalid website registry")
    return config

def allowed_env(raw_env):
    allowed = {
        "DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY",
        "DBUS_SESSION_BUS_ADDRESS", "DBUS_SYSTEM_BUS_ADDRESS",
        "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE", "XDG_CURRENT_DESKTOP",
        "HOME", "USER", "LOGNAME", "SHELL", "PATH",
        "LANG", "LC_ALL", "LC_CTYPE", "LC_MESSAGES", "TERM",
    }
    env = {}
    for key, value in (raw_env or {}).items():
        if key in allowed and isinstance(value, str):
            env[key] = value
    return env

def check_code(app_name, supplied_code):
    salt, expected = read_code()
    digest = hashlib.sha256(f"{salt}:{supplied_code}".encode("utf-8")).hexdigest()
    return hmac.compare_digest(digest, expected)

def failure_count(uid):
    now = time.time()
    with failures_lock:
        recent = [when for when in failures.get(uid, []) if now - when < FAILURE_WINDOW]
        failures[uid] = recent
        return len(recent)

def record_failure(uid):
    now = time.time()
    with failures_lock:
        recent = [when for when in failures.get(uid, []) if now - when < FAILURE_WINDOW]
        recent.append(now)
        failures[uid] = recent
        return len(recent) >= FAILURE_LIMIT

def clear_failures(uid):
    with failures_lock:
        failures.pop(uid, None)

def log(message):
    print(message, flush=True)

def groups_for_user(uid):
    pw = pwd.getpwuid(uid)
    group_ids = {pw.pw_gid}
    for group in grp.getgrall():
        if pw.pw_name in group.gr_mem:
            group_ids.add(group.gr_gid)
    return sorted(group_ids)


def launch_app(app, uid, gid, env):
    path = app["path"]
    argv = app.get("argv") or [path]
    pw = pwd.getpwuid(uid)

    env = dict(env)
    env.update({
        "HOME": pw.pw_dir,
        "USER": pw.pw_name,
        "LOGNAME": pw.pw_name,
        "SHELL": pw.pw_shell,
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "XDG_RUNTIME_DIR": f"/run/user/{uid}",
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{uid}/bus",
    })

    try:
        subprocess.Popen(
            argv,
            executable=path,
            env=env,
            cwd=pw.pw_dir if os.path.isdir(pw.pw_dir) else "/",
            user=pw.pw_name,
            group=gid,
            extra_groups=groups_for_user(uid),
            start_new_session=True,
            close_fds=True,
        )
    except Exception as exc:
        log(f"failed to launch {path}: {exc}")
        raise

lock_sync_stop = threading.Event()
lock_sync_now = threading.Event()

def handle_profile_sync_signal(signum, frame):
    lock_sync_now.set()

def sync_locks(reason):
    config = load_config()
    apps = config.get("apps", {})
    websites = config.get("websites", {})
    active = common.active_apps(apps)
    active_websites = common.active_websites(websites)

    signature = sorted((name, info.get("path", "")) for name, info in active.items())
    signature.extend(
        (name, tuple(common.website_domains(name, info)))
        for name, info in active_websites.items()
    )
    signature = sorted(signature)

    if reason == "startup" or signature != getattr(sync_locks, "last_signature", None):
        common.sync_profile(apps)
        common.sync_website_blocks(websites)
        sync_locks.last_signature = signature
        log(
            f"App Lock schedule updated ({reason}); "
            f"{len(active)} app(s) and {len(active_websites)} website(s) locked"
        )

def lock_sync_worker():
    while not lock_sync_stop.is_set():
        triggered = lock_sync_now.wait(5)
        lock_sync_now.clear()
        if lock_sync_stop.is_set():
            break
        try:
            sync_locks("signal" if triggered else "timer")
        except Exception as exc:
            log(f"App Lock schedule update failed: {exc}")

def peer_credentials(connection):
    credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
    _pid, uid, gid = struct.unpack("=III", credentials)
    return uid, gid

def handle_client(connection):
    connection.settimeout(5)
    try:
        uid, gid = peer_credentials(connection)
        chunks = []
        total = 0
        while total < MAX_REQUEST_SIZE:
            chunk = connection.recv(4096)
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if b"\n" in chunk:
                break
        raw = b"".join(chunks).split(b"\n", 1)[0]
        request = json.loads(raw.decode("utf-8"))
        app_name = request.get("app")
        supplied_code = request.get("code")
        raw_env = request.get("env")

        if not isinstance(app_name, str):
            raise ValueError("invalid request")

        apps = load_config().get("apps", {})
        app = apps.get(app_name)
        if app is None:
            raise PermissionError("request denied")

        if not common.schedule_is_locked(app.get("schedule")):
            env = allowed_env(raw_env)
            launch_app(app, uid, gid, env)
            log(f"launched unlocked {app_name} for uid {uid}")
            connection.sendall(json.dumps({"status": "launched"}).encode("utf-8") + b"\n")
            return

        if not isinstance(supplied_code, str):
            raise PermissionError("invalid code")

        if failure_count(uid) >= FAILURE_LIMIT:
            log(f"rate limit exceeded for uid {uid}")
            raise PermissionError("too many failed attempts")

        if not check_code(app_name, supplied_code):
            rate_limited = record_failure(uid)
            log(f"invalid code from uid {uid}")
            if rate_limited:
                raise PermissionError("too many failed attempts; try again later")
            raise PermissionError("invalid code")

        clear_failures(uid)
        env = allowed_env(raw_env)
        launch_app(app, uid, gid, env)
        log(f"launched {app_name} for uid {uid}")
        connection.sendall(json.dumps({"status": "launched"}).encode() + b"\n")
    except Exception as exc:
        try:
            connection.sendall(json.dumps({"status": "error", "message": str(exc)}).encode() + b"\n")
        except Exception:
            pass
    finally:
        connection.close()

def stop_server(signum, frame):
    global server_socket
    lock_sync_stop.set()
    lock_sync_now.set()
    if server_socket is not None:
        try:
            server_socket.close()
        except Exception:
            pass
    if Path(SOCKET_PATH).exists():
        try:
            Path(SOCKET_PATH).unlink()
        except Exception:
            pass
    sys.exit(0)

def main():
    global server_socket

    socket_dir = Path(SOCKET_PATH).parent
    socket_dir.mkdir(parents=True, exist_ok=True)
    if Path(SOCKET_PATH).exists():
        Path(SOCKET_PATH).unlink()

    server_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server_socket.bind(SOCKET_PATH)
    try:
        os.chmod(SOCKET_PATH, 0o660)
        group = grp.getgrnam("applock")
        os.chown(SOCKET_PATH, 0, group.gr_gid)
    except KeyError:
        pass
    except Exception as exc:
        log(f"could not set applock group on socket: {exc}")

    signal.signal(signal.SIGCHLD, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, handle_profile_sync_signal)
    signal.signal(signal.SIGTERM, stop_server)
    signal.signal(signal.SIGINT, stop_server)
    server_socket.set_inheritable(False)
    server_socket.listen(16)

    lock_sync_now.set()
    sync_thread = threading.Thread(target=lock_sync_worker, name="applock-schedule", daemon=True)
    sync_thread.start()

    log("applockd listening")

    while True:
        connection, _ = server_socket.accept()
        threading.Thread(target=handle_client, args=(connection,), daemon=True).start()

if __name__ == "__main__":
    main()
